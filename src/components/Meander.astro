---
/** Greek key (meander) band — the classical through-line. Tiles horizontally. */
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
<svg class:list={["meander", cls]} aria-hidden="true" width="100%" height="14">
  <defs>
    <pattern id="meander-tile" width="28" height="14" patternUnits="userSpaceOnUse">
      <path d="M1 13 V1 H21 V9 H9 V5 H17" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
      <path d="M21 13 H27" stroke="currentColor" stroke-width="1.4" />
    </pattern>
  </defs>
  <rect width="100%" height="14" fill="url(#meander-tile)" />
</svg>
<style>
  .meander { display: block; color: var(--accent); opacity: 0.55; }
</style>
